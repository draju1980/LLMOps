# LLMOps Infrastructure Configuration
# Copy this file to .env and customize as needed

# PostgreSQL
POSTGRES_USER=llmops
POSTGRES_PASSWORD=llmops-password
POSTGRES_DB=llmops_db

# LocalStack (S3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-password
AWS_DEFAULT_REGION=us-east-1

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin

# MLflow Database
MLFLOW_BACKEND_DB_URI=postgresql://llmops:llmops-password@postgres:5432/mlflow_db
MLFLOW_S3_ENDPOINT_URL=http://minio:4566

# Optional: Jaeger
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# Optional: Qdrant
QDRANT_API_KEY=qdrant-api-key
